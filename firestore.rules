rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /peak/{doc} {
      allow read, write: if true;
    }

    // usernames/{username} maps a claimed username to its owning uid — see
    // .design/feature-brainstorm/USERNAME_AND_COMPARISON.md. Not currently
    // load-bearing: the app has no direct client-side Firestore access
    // today (src/app.jsx only uses firebase/auth; all data goes through the
    // Cloud Functions API, which uses the Admin SDK and bypasses these
    // rules entirely). Written now anyway so uniqueness stays enforced if
    // client-side reads (e.g. search) are ever added directly against
    // Firestore instead of through the API. Read is open (usernames aren't
    // sensitive on their own); create/update is restricted to the doc's own
    // claimed uid so a direct client write can't squat/steal a username —
    // the real enforcement (the claim transaction, the format/uniqueness
    // checks, the monthly rate limit) lives server-side regardless.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
