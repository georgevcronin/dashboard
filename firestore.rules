rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /peak/{doc} {
      allow read, write: if true;
    }

    // usernames/{username} maps a claimed username to its owning uid — see
    // .design/feature-brainstorm/USERNAME_AND_COMPARISON.md. Not currently
    // load-bearing: the app has no direct client-side Firestore access
    // today (src/app.jsx only uses firebase/auth; all data goes through the
    // Cloud Functions API, which uses the Admin SDK and bypasses these
    // rules entirely). Written now anyway so uniqueness stays enforced if
    // client-side reads (e.g. search) are ever added directly against
    // Firestore instead of through the API. Read is open (usernames aren't
    // sensitive on their own); create/update is restricted to the doc's own
    // claimed uid so a direct client write can't squat/steal a username —
    // the real enforcement (the claim transaction, the format/uniqueness
    // checks, the monthly rate limit) lives server-side regardless.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // liveSessions/{sessionId} — see
    // .design/feature-brainstorm/GROUP_WORKOUT.md §7. Same caveat as
    // usernames/ above: not currently load-bearing (all real enforcement —
    // the 4-participant cap, the mutual-edit/locked-on-exit rules, the
    // inactivity sweep — lives in functions/index.js's Cloud Function
    // endpoints, which use the Admin SDK and bypass these rules). Written
    // for correctness in case direct client Firestore access is ever added.
    match /liveSessions/{sessionId} {
      // participantUids is a flat array kept in sync with the richer
      // `participants` array (functions/index.js) purely so rules can do a
      // plain `in` check — Firestore's rules language has no lambda/map()
      // support (confirmed by an actual compile failure against the
      // Firestore emulator during testing, not just the doc's original
      // "needs verifying" caveat), so `participants.map(p => p.uid)` is
      // invalid syntax, not just a style choice.
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow read: if request.auth != null && request.auth.uid in resource.data.participantUids;
      // Participant-list mutations (join/leave/finish/activity) are meant to
      // go through the Cloud Function endpoints, which enforce the
      // 4-participant cap and that a status change only ever touches the
      // caller's own entry — a direct client write only needs to remain a
      // participant to write here at all, same trust boundary as the rest
      // of this flat-mutual-trust feature.
      allow update: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /entries/{entryId} {
        // Full mutual read/write while both the editor and the entry's
        // owner are still "active" participants — deliberately not scoped
        // to "only the entry's own uid may write it" (GROUP_WORKOUT.md §3's
        // flat trust model), but never open to someone who isn't a current
        // participant at all.
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.participantUids;
        allow create, update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/liveSessions/$(sessionId)).data.participantUids;
      }
    }
  }
}
